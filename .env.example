# ============================================================
# HelpPet API Gateway - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

# Perfil Spring ativo (local=dev | Azure=prod)
SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=help-pet-gateway
SERVER_PORT=8080

# JWT - OBRIGATORIO: no minimo 64 caracteres
# Gere com: openssl rand -hex 64
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_MINIMO_64_CARACTERES_AQUI
JWT_EXPIRATION=86400000

# Token interno Gateway -> Microservicos (OBRIGATORIO em producao)
# Gere com: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=SUBSTITUA_POR_TOKEN_INTERNO_SEGURO

# Redis Aiven (Rate Limiting)
# Formato completo: rediss://default:<SENHA>@gateway-help-pet-g8-vhzzlk.i.aivencloud.com:16321
REDIS_HOST=gateway-help-pet-g8-vhzzlk.i.aivencloud.com
REDIS_PORT=16321
REDIS_USERNAME=default
REDIS_PASSWORD=SUBSTITUA_PELA_SENHA_DO_REDIS_AIVEN

# URLs dos Microservicos (G1-G5)
# Localmente use http://localhost:808x
# Na Azure use as URLs dos outros App Services
G1_URL=http://localhost:8081
G2_URL=http://localhost:8082
G3_URL=http://localhost:8083
G4_URL=http://localhost:8084
G5_URL=http://localhost:8085

# Rate Limiting (requisicoes por segundo por IP)
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40

# CORS - origens permitidas (separadas por virgula, sem barra no final)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Health check dos microservicos (true=monitora | false=ignora)
MANAGEMENT_HEALTH_REDIS_ENABLED=true

# Azure App Service: porta exposta pelo container
# WEBSITES_PORT=8080
