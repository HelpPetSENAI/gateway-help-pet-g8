# ============================================================
# HelpPet API Gateway - Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env no Git
# ============================================================

# Identificacao da aplicacao
SPRING_APPLICATION_NAME=help-pet-gateway
SERVER_PORT=8080

# JWT - OBRIGATORIO: gere uma chave segura de no minimo 64 caracteres
# Exemplo para gerar: openssl rand -hex 64
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_SEGURA_DE_MINIMO_64_CARACTERES_AQUI
JWT_EXPIRATION=86400000

# Token interno Gateway -> Microsservicos (OBRIGATORIO em producao)
# Gere com: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=SUBSTITUA_POR_TOKEN_INTERNO_SEGURO

# Redis (Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# URLs dos Microservicos
IDENTITY_SECURITY_URL=http://localhost:8081
PET_MANAGEMENT_URL=http://localhost:8082
LOST_FOUND_PETS_URL=http://localhost:8083
LOCATION_DISTANCE_URL=http://localhost:8084
ADOPTION_PROCESS_URL=http://localhost:8085
COMMUNICATION_CHAT_URL=http://localhost:8086
SYSTEM_ALERTS_URL=http://localhost:8087

# Rate Limiting (requisicoes por segundo por IP)
RATE_LIMIT_REPLENISH_RATE=20
RATE_LIMIT_BURST_CAPACITY=40

# CORS - origens permitidas (separadas por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
